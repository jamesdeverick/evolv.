# ========== LLM Provider Configuration ==========
# Choose: "ollama" (local), "deepseek" (cloud), or "openai" (cloud)
LLM_PROVIDER=deepseek

# ========== Ollama Configuration (for local development) ==========
OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:latest

# ========== Deepseek Configuration (for cloud deployment) ==========
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# ========== OpenAI Configuration (alternative cloud option) ==========
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# ========== Scrapingdog Configuration ==========
# Get your API key from: https://www.scrapingdog.com/
SCRAPINGDOG_API_KEY=your_scrapingdog_api_key_here

# ========== Optional: Tone of Voice Notes ==========
CLIENT_TONE_NOTES=""
